   </section><!-- QUIZ PAGE -->
   <section id="page-quiz" class="page min-h-full bg-gradient-to-b from-gray-900 via-gray-800 to-gray-900 pt-24 pb-16 px-4">
    <div class="max-w-3xl mx-auto"><!-- Quiz Start Screen -->
     <div id="quiz-start" class="text-center">
      <div class="float-animation mb-8">
       <div class="w-24 h-24 mx-auto bmw-blue-gradient rounded-full flex items-center justify-center glow-effect">
        <svg class="w-12 h-12" fill="none" stroke="currentColor" viewbox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
        </svg>
       </div>
      </div>
      <h1 class="font-orbitron text-4xl md:text-5xl font-black mb-4">QUIZ BMW</h1>
      <p class="text-gray-400 text-lg mb-8">Testează-ți cunoștințele despre istoria și modelele BMW!</p>
      <div class="glass-effect rounded-2xl p-8 mb-8">
       <div class="grid grid-cols-3 gap-4 mb-6">
        <div class="text-center">
         <p class="font-orbitron text-3xl font-bold text-blue-400">10</p>
         <p class="text-gray-400 text-sm">Întrebări</p>
        </div>
        <div class="text-center">
         <p class="font-orbitron text-3xl font-bold text-blue-400">30s</p>
         <p class="text-gray-400 text-sm">Per Întrebare</p>
        </div>
        <div class="text-center">
         <p class="font-orbitron text-3xl font-bold text-blue-400">100</p>
         <p class="text-gray-400 text-sm">Puncte Max</p>
        </div>
       </div>
       <p class="text-gray-300 text-sm">Răspunde corect și rapid pentru punctaj maxim!</p>
      </div><button onclick="startQuiz()" class="px-12 py-5 bmw-blue-gradient rounded-xl font-orbitron font-bold text-xl hover:scale-105 transition-transform glow-effect"> ÎNCEPE QUIZ-UL </button>
     </div><!-- Quiz Questions Screen -->
     <div id="quiz-questions" class="hidden"><!-- Progress Bar -->
      <div class="mb-8">
       <div class="flex justify-between items-center mb-2"><span class="font-orbitron text-sm">Întrebarea <span id="current-question">1</span>/10</span> <span class="font-orbitron text-sm">Scor: <span id="current-score">0</span></span>
       </div>
       <div class="h-3 bg-gray-700 rounded-full overflow-hidden">
        <div id="progress-bar" class="h-full bmw-blue-gradient progress-bar" style="width: 10%"></div>
       </div>
      </div><!-- Timer -->
      <div class="flex justify-center mb-6">
       <div class="glass-effect rounded-full px-6 py-2 flex items-center gap-2">
        <svg class="w-5 h-5 text-blue-400" fill="none" stroke="currentColor" viewbox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg><span id="timer" class="font-orbitron text-xl font-bold text-blue-400">30</span>
       </div>
      </div><!-- Question Card -->
      <div class="glass-effect rounded-2xl p-8 mb-6">
       <h2 id="question-text" class="font-orbitron text-xl md:text-2xl font-bold text-center mb-8">Întrebarea va apărea aici...</h2>
       <div id="options-container" class="space-y-4"><!-- Options will be inserted here -->
       </div>
      </div><!-- Feedback -->
      <div id="feedback" class="hidden text-center">
       <div id="feedback-content" class="glass-effect rounded-xl p-4 mb-4"></div><button onclick="nextQuestion()" class="px-8 py-3 bmw-blue-gradient rounded-xl font-orbitron font-bold hover:scale-105 transition-transform"> URMĂTOAREA → </button>
      </div>
     </div><!-- Quiz Results Screen -->
     <div id="quiz-results" class="hidden text-center">
      <div class="float-animation mb-8">
       <div id="result-icon" class="w-32 h-32 mx-auto rounded-full flex items-center justify-center glow-effect"><!-- Icon will be set based on score -->
       </div>
      </div>
      <h1 id="result-title" class="font-orbitron text-4xl font-black mb-4">Felicitări!</h1>
      <p id="result-subtitle" class="text-gray-400 text-lg mb-8">Ai terminat quiz-ul!</p>
      <div class="glass-effect rounded-2xl p-8 mb-8">
       <div class="font-orbitron text-6xl font-black text-blue-400 mb-2"><span id="final-score">0</span>/100
       </div>
       <p class="text-gray-400">Puncte obținute</p>
       <div class="grid grid-cols-2 gap-4 mt-6">
        <div class="p-4 bg-green-900/30 rounded-xl">
         <p class="font-orbitron text-2xl font-bold text-green-400" id="correct-count">0</p>
         <p class="text-gray-400 text-sm">Corecte</p>
        </div>
        <div class="p-4 bg-red-900/30 rounded-xl">
         <p class="font-orbitron text-2xl font-bold text-red-400" id="wrong-count">0</p>
         <p class="text-gray-400 text-sm">Greșite</p>
        </div>
       </div>
      </div>
      <div class="flex flex-col sm:flex-row justify-center gap-4"><button onclick="restartQuiz()" class="px-8 py-4 bmw-blue-gradient rounded-xl font-orbitron font-bold hover:scale-105 transition-transform"> ÎNCEARCĂ DIN NOU </button> <button onclick="navigateTo('home')" class="px-8 py-4 glass-effect rounded-xl font-orbitron font-bold hover:bg-white/10 transition-all border border-blue-500/50"> ÎNAPOI ACASĂ </button>
      </div>
     </div>
    </div>
   </section>
  </main><!-- Footer -->
  <footer class="bg-gray-900 border-t border-gray-800 py-8 px-4">
   <div class="max-w-6xl mx-auto text-center">
    <div class="flex items-center justify-center gap-3 mb-4">
     <div class="w-10 h-10 rounded-full bmw-blue-gradient flex items-center justify-center">
      <svg viewbox="0 0 100 100" class="w-6 h-6"><circle cx="50" cy="50" r="48" fill="none" stroke="white" stroke-width="3" /> <path d="M50 2 A48 48 0 0 1 98 50 L50 50 Z" fill="#0066cc" /> <path d="M2 50 A48 48 0 0 1 50 98 L50 50 Z" fill="#0066cc" /> <path d="M50 2 A48 48 0 0 0 2 50 L50 50 Z" fill="white" /> <path d="M98 50 A48 48 0 0 0 50 98 L50 50 Z" fill="white" />
      </svg>
     </div><span class="font-orbitron font-bold">BMW HISTORY</span>
    </div>
    <p class="text-gray-500 text-sm">Proiect pentru Atestatul de Informatică și TIC</p>
    <p class="text-gray-600 text-xs mt-2">© 2024 • Toate drepturile rezervate BMW AG pentru marca și logo-ul BMW</p>
   </div>
  </footer>
  <script>
    // Default configuration
    const defaultConfig = {
      site_title: 'BMW HISTORY',
      hero_subtitle: 'SHEER DRIVING PLEASURE'
    };

    // Quiz Questions
    const quizQuestions = [
      {
        question: "În ce an a fost fondată compania BMW?",
        options: ["1910", "1916", "1922", "1928"],
        correct: 1
      },
      {
        question: "Ce însemnă acronimul BMW?",
        options: ["Bavarian Motor Works", "Berlin Motor Werke", "Bayerische Motoren Werke", "Best Motor Worldwide"],
        correct: 2
      },
      {
        question: "Ce producea inițial BMW?",
        options: ["Motociclete", "Automobile", "Motoare de avioane", "Biciclete"],
        correct: 2
      },
      {
        question: "În ce an a fost lansată prima motocicletă BMW?",
        options: ["1920", "1923", "1928", "1932"],
        correct: 1
      },
      {
        question: "Care este sediul central al BMW?",
        options: ["München", "Stuttgart", "Berlin", "Frankfurt"],
        correct: 0
      },
      {
        question: "În ce an a fost fondată divizia BMW Motorsport (M)?",
        options: ["1968", "1972", "1978", "1982"],
        correct: 1
      },
      {
        question: "Care a fost primul model BMW M?",
        options: ["M3", "M5", "M1", "M6"],
        correct: 2
      },
      {
        question: "Ce model BMW a câștigat Le Mans în 1999?",
        options: ["M3 GTR", "V12 LMR", "Z4 GT3", "M8 GTE"],
        correct: 1
      },
      {
        question: "Care este sloganul oficial BMW?",
        options: ["The Ultimate Driving Machine", "Performance First", "Innovation and Technology", "Sheer Driving Pleasure"],
        correct: 3
      },
      {
        question: "În ce an a fost lansat primul BMW electric (i3)?",
        options: ["2010", "2013", "2015", "2018"],
        correct: 1
      }
    ];

    let currentQuestion = 0;
    let score = 0;
    let correctAnswers = 0;
    let timerInterval = null;
    let timeLeft = 30;

    // Navigation function
    function navigateTo(pageId) {
      // Hide all pages
      document.querySelectorAll('.page').forEach(page => {
        page.classList.remove('active');
      });
      
      // Show target page
      const targetPage = document.getElementById('page-' + pageId);
      if (targetPage) {
        targetPage.classList.add('active');
      }
      
      // Update nav buttons
      document.querySelectorAll('[data-page]').forEach(btn => {
        btn.classList.remove('bg-blue-600/30');
        if (btn.dataset.page === pageId) {
          btn.classList.add('bg-blue-600/30');
        }
      });
      
      // Scroll to top
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // Mobile menu toggle
    function toggleMobileMenu() {
      const menu = document.getElementById('mobile-menu');
      menu.classList.toggle('hidden');
    }

    // Quiz functions
    function startQuiz() {
      currentQuestion = 0;
      score = 0;
      correctAnswers = 0;
      
      document.getElementById('quiz-start').classList.add('hidden');
      document.getElementById('quiz-questions').classList.remove('hidden');
      document.getElementById('quiz-results').classList.add('hidden');
      
      showQuestion();
    }

    function showQuestion() {
      const q = quizQuestions[currentQuestion];
      
      document.getElementById('current-question').textContent = currentQuestion + 1;
      document.getElementById('current-score').textContent = score;
      document.getElementById('progress-bar').style.width = ((currentQuestion + 1) / quizQuestions.length * 100) + '%';
      document.getElementById('question-text').textContent = q.question;
      document.getElementById('feedback').classList.add('hidden');
      
      const optionsContainer = document.getElementById('options-container');
      optionsContainer.innerHTML = '';
      
      q.options.forEach((option, index) => {
        const btn = document.createElement('button');
        btn.className = 'quiz-option w-full p-4 glass-effect rounded-xl text-left font-semibold hover:border-blue-500 border-2 border-transparent transition-all';
        btn.innerHTML = `<span class="text-blue-400 mr-3">${String.fromCharCode(65 + index)}.</span> ${option}`;
        btn.onclick = () => selectAnswer(index);
        optionsContainer.appendChild(btn);
      });
      
      // Start timer
      timeLeft = 30;
      document.getElementById('timer').textContent = timeLeft;
      
      if (timerInterval) clearInterval(timerInterval);
      timerInterval = setInterval(() => {
        timeLeft--;
        document.getElementById('timer').textContent = timeLeft;
        
        if (timeLeft <= 0) {
          clearInterval(timerInterval);
          selectAnswer(-1); // Time's up
        }
      }, 1000);
    }

    function selectAnswer(selectedIndex) {
      clearInterval(timerInterval);
      
      const q = quizQuestions[currentQuestion];
      const options = document.querySelectorAll('.quiz-option');
      
      options.forEach((opt, index) => {
        opt.classList.add('disabled');
        opt.onclick = null;
        
        if (index === q.correct) {
          opt.classList.add('correct');
        } else if (index === selectedIndex && selectedIndex !== q.correct) {
          opt.classList.add('incorrect');
        }
      });
      
      const feedbackDiv = document.getElementById('feedback');
      const feedbackContent = document.getElementById('feedback-content');
      
      if (selectedIndex === q.correct) {
        const points = Math.max(5, Math.round(10));
        score += points;
        correctAnswers++;
        feedbackContent.innerHTML = `<span class="text-green-400 font-bold">✓ Corect!</span> +${points} puncte`;
        feedbackContent.className = 'glass-effect rounded-xl p-4 mb-4 border border-green-500/50';
      } else if (selectedIndex === -1) {
        feedbackContent.innerHTML = `<span class="text-yellow-400 font-bold">⏱ Timpul a expirat!</span> Răspunsul corect era: ${q.options[q.correct]}`;
        feedbackContent.className = 'glass-effect rounded-xl p-4 mb-4 border border-yellow-500/50';
      } else {
        feedbackContent.innerHTML = `<span class="text-red-400 font-bold">✗ Greșit!</span> Răspunsul corect era: ${q.options[q.correct]}`;
        feedbackContent.className = 'glass-effect rounded-xl p-4 mb-4 border border-red-500/50';
      }
      
      feedbackDiv.classList.remove('hidden');
    }

    function nextQuestion() {
      currentQuestion++;
      
      if (currentQuestion >= quizQuestions.length) {
        showResults();
      } else {
        showQuestion();
      }
    }

    function showResults() {
      document.getElementById('quiz-questions').classList.add('hidden');
      document.getElementById('quiz-results').classList.remove('hidden');
      
      const finalScore = score;
      const wrongAnswers = quizQuestions.length - correctAnswers;
      
      document.getElementById('final-score').textContent = finalScore;
      document.getElementById('correct-count').textContent = correctAnswers;
      document.getElementById('wrong-count').textContent = wrongAnswers;
      
      const resultIcon = document.getElementById('result-icon');
      const resultTitle = document.getElementById('result-title');
      const resultSubtitle = document.getElementById('result-subtitle');
      
      if (finalScore >= 80) {
        resultIcon.className = 'w-32 h-32 mx-auto rounded-full flex items-center justify-center glow-effect bg-gradient-to-br from-yellow-500 to-yellow-700';
        resultIcon.innerHTML = '<span class="text-5xl">🏆</span>';
        resultTitle.textContent = 'Expert BMW!';
        resultSubtitle.textContent = 'Ești un adevărat cunoscător BMW!';
      } else if (finalScore >= 50) {
        resultIcon.className = 'w-32 h-32 mx-auto rounded-full flex items-center justify-center glow-effect bmw-blue-gradient';
        resultIcon.innerHTML = '<span class="text-5xl">👍</span>';
        resultTitle.textContent = 'Bine lucrat!';
        resultSubtitle.textContent = 'Ai cunoștințe solide despre BMW!';
      } else {
        resultIcon.className = 'w-32 h-32 mx-auto rounded-full flex items-center justify-center glow-effect bg-gradient-to-br from-gray-600 to-gray-800';
        resultIcon.innerHTML = '<span class="text-5xl">📚</span>';
        resultTitle.textContent = 'Mai exersează!';
        resultSubtitle.textContent = 'Revizuiește site-ul și încearcă din nou!';
      }
    }

    function restartQuiz() {
      document.getElementById('quiz-results').classList.add('hidden');
      document.getElementById('quiz-start').classList.remove('hidden');
    }

    // Element SDK Integration
    function initElementSdk() {
      if (window.elementSdk) {
        window.elementSdk.init({
          defaultConfig: defaultConfig,
          onConfigChange: async (config) => {
            // Update site title
            const navTitle = document.getElementById('nav-title');
            if (navTitle) {
              navTitle.textContent = config.site_title || defaultConfig.site_title;
            }
            
            // Update hero subtitle
            const heroSubtitle = document.getElementById('hero-subtitle');
            if (heroSubtitle) {
              heroSubtitle.textContent = config.hero_subtitle || defaultConfig.hero_subtitle;
            }
          },
          mapToCapabilities: (config) => ({
            recolorables: [],
            borderables: [],
            fontEditable: undefined,
            fontSizeable: undefined
          }),
          mapToEditPanelValues: (config) => new Map([
            ['site_title', config.site_title || defaultConfig.site_title],
            ['hero_subtitle', config.hero_subtitle || defaultConfig.hero_subtitle]
          ])
        });
      }
    }

    // Initialize
    initElementSdk();
  </script>
