     <div class="glass-effect rounded-2xl p-8 mb-8">
      <h2 class="font-orbitron text-2xl font-bold mb-8 text-center">TEHNOLOGIE ELECTRICĂ BMW i</h2>
      <div class="grid md:grid-cols-4 gap-6">
