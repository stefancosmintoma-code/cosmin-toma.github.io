 <!doctype html>
<html lang="ro" class="h-full">
 <head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Istoria BMW - Atestat Informatică</title>
  <script src="https://cdn.tailwindcss.com/3.4.17"></script>
  <script src="/_sdk/element_sdk.js"></script>
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;500;600;700;800;900&amp;family=Rajdhani:wght@300;400;500;600;700&amp;display=swap" rel="stylesheet">
  <style>
    * { box-sizing: border-box; }
    html, body { height: 100%; margin: 0; padding: 0; }
    
    .font-orbitron { font-family: 'Orbitron', monospace; }
    .font-rajdhani { font-family: 'Rajdhani', sans-serif; }
    
    .page { display: none; opacity: 0; transition: opacity 0.5s ease; }
    .page.active { display: block; opacity: 1; }
    
    .nav-btn {
      position: relative;
      overflow: hidden;
      transition: all 0.3s ease;
    }
    .nav-btn::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
      transition: left 0.5s ease;
    }
    .nav-btn:hover::before { left: 100%; }
    
    .card-hover {
      transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    .card-hover:hover {
      transform: translateY(-10px) scale(1.02);
      box-shadow: 0 25px 50px -12px rgba(0, 102, 204, 0.4);
    }
    
    .timeline-item {
      opacity: 0;
      transform: translateX(-50px);
      animation: slideIn 0.6s ease forwards;
    }
    .timeline-item:nth-child(1) { animation-delay: 0.1s; }
    .timeline-item:nth-child(2) { animation-delay: 0.2s; }
    .timeline-item:nth-child(3) { animation-delay: 0.3s; }
    .timeline-item:nth-child(4) { animation-delay: 0.4s; }
    .timeline-item:nth-child(5) { animation-delay: 0.5s; }
    .timeline-item:nth-child(6) { animation-delay: 0.6s; }
    
    @keyframes slideIn {
      to { opacity: 1; transform: translateX(0); }
    }
    
    @keyframes pulse-glow {
      0%, 100% { box-shadow: 0 0 20px rgba(0, 102, 204, 0.5); }
      50% { box-shadow: 0 0 40px rgba(0, 102, 204, 0.8), 0 0 60px rgba(0, 102, 204, 0.4); }
    }
    
    .glow-effect { animation: pulse-glow 2s ease-in-out infinite; }
    
    @keyframes float {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-20px); }
    }
    .float-animation { animation: float 3s ease-in-out infinite; }
    
    .progress-bar {
      transition: width 0.5s ease;
    }
    
    .quiz-option {
      transition: all 0.3s ease;
      cursor: pointer;
    }
    .quiz-option:hover:not(.disabled) {
      transform: scale(1.02);
      border-color: #0066cc;
    }
    .quiz-option.correct {
      background: linear-gradient(135deg, #10b981, #059669) !important;
      border-color: #10b981 !important;
      color: white !important;
    }
    .quiz-option.incorrect {
      background: linear-gradient(135deg, #ef4444, #dc2626) !important;
      border-color: #ef4444 !important;
      color: white !important;
    }
    
    .hero-gradient {
      background: linear-gradient(135deg, #0a0a0a 0%, #1a1a2e 50%, #0d0d1a 100%);
    }
    
    .bmw-blue-gradient {
      background: linear-gradient(135deg, #0066cc 0%, #004499 100%);
    }
    
    .glass-effect {
      background: rgba(255, 255, 255, 0.05);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.1);
    }
    
    .counter-animation {
      display: inline-block;
    }
    
    @keyframes countUp {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }
    
    .stat-number {
      animation: countUp 0.8s ease forwards;
    }
    
    .model-card {
      background: linear-gradient(145deg, #1a1a2e, #0d0d1a);
      border: 1px solid rgba(0, 102, 204, 0.3);
    }
    
    .scrollbar-hide::-webkit-scrollbar { display: none; }
    .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
  </style>
  <style>body { box-sizing: border-box; }</style>
  <script src="/_sdk/data_sdk.js" type="text/javascript"></script>
 </head>
 <body class="h-full bg-gray-900 text-white font-rajdhani scrollbar-hide overflow-auto"><!-- Navigation -->
  <nav id="main-nav" class="fixed top-0 left-0 right-0 z-50 glass-effect">
   <div class="max-w-7xl mx-auto px-4 py-3">
    <div class="flex items-center justify-between">
     <div class="flex items-center gap-3">
      <div class="w-12 h-12 rounded-full bmw-blue-gradient flex items-center justify-center glow-effect">
  <img src="https://uploads.onecompiler.io/44e455y47/44e456xmr/bmw.png" alt="Sigla Site" class="w-8 h-8 object-contain" />
</div>

      </div><span id="nav-title" class="font-orbitron text-xl font-bold tracking-wider">BMW HISTORY</span>
     </div>
     <div class="hidden md:flex items-center gap-2"><button onclick="navigateTo('home')" class="nav-btn px-4 py-2 rounded-lg text-sm font-semibold hover:bg-blue-600/30 transition-all" data-page="home">ACASĂ</button> <button onclick="navigateTo('history')" class="nav-btn px-4 py-2 rounded-lg text-sm font-semibold hover:bg-blue-600/30 transition-all" data-page="history">ISTORIE</button> <button onclick="navigateTo('models')" class="nav-btn px-4 py-2 rounded-lg text-sm font-semibold hover:bg-blue-600/30 transition-all" data-page="models">MODELE</button> <button onclick="navigateTo('technology')" class="nav-btn px-4 py-2 rounded-lg text-sm font-semibold hover:bg-blue-600/30 transition-all" data-page="technology">TEHNOLOGIE</button> <button onclick="navigateTo('motorsport')" class="nav-btn px-4 py-2 rounded-lg text-sm font-semibold hover:bg-blue-600/30 transition-all" data-page="motorsport">MOTORSPORT</button> <button onclick="navigateTo('quiz')" class="nav-btn px-4 py-2 rounded-lg bmw-blue-gradient text-sm font-semibold glow-effect" data-page="quiz">QUIZ</button>
     </div><button onclick="toggleMobileMenu()" class="md:hidden p-2 rounded-lg hover:bg-blue-600/30">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewbox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg></button>
    </div><!-- Mobile Menu -->
    <div id="mobile-menu" class="hidden md:hidden mt-4 pb-4 border-t border-white/10 pt-4">
     <div class="flex flex-col gap-2"><button onclick="navigateTo('home'); toggleMobileMenu();" class="nav-btn px-4 py-3 rounded-lg text-left font-semibold hover:bg-blue-600/30">ACASĂ</button> <button onclick="navigateTo('history'); toggleMobileMenu();" class="nav-btn px-4 py-3 rounded-lg text-left font-semibold hover:bg-blue-600/30">ISTORIE</button> <button onclick="navigateTo('models'); toggleMobileMenu();" class="nav-btn px-4 py-3 rounded-lg text-left font-semibold hover:bg-blue-600/30">MODELE</button> <button onclick="navigateTo('technology'); toggleMobileMenu();" class="nav-btn px-4 py-3 rounded-lg text-left font-semibold hover:bg-blue-600/30">TEHNOLOGIE</button> <button onclick="navigateTo('motorsport'); toggleMobileMenu();" class="nav-btn px-4 py-3 rounded-lg text-left font-semibold hover:bg-blue-600/30">MOTORSPORT</button> <button onclick="navigateTo('quiz'); toggleMobileMenu();" class="nav-btn px-4 py-3 rounded-lg bmw-blue-gradient font-semibold text-center">QUIZ</button>
     </div>
    </div>
   </div>
  </nav><!-- Page Container -->
  <main class="w-full min-h-full"><!-- HOME PAGE -->
   <section id="page-home" class="page active min-h-full"><!-- Hero Section -->
    <div class="hero-gradient min-h-screen flex items-center justify-center relative overflow-hidden pt-20">
     <div class="absolute inset-0 opacity-20">
      <div class="absolute top-20 left-10 w-72 h-72 bg-blue-500 rounded-full filter blur-3xl"></div>
      <div class="absolute bottom-20 right-10 w-96 h-96 bg-blue-700 rounded-full filter blur-3xl"></div>
     </div>
     <div class="relative z-10 text-center px-4 max-w-5xl mx-auto">
      <div class="float-animation mb-8">
       <div class="w-32 h-32 mx-auto rounded-full bmw-blue-gradient flex items-center justify-center glow-effect">
       <img src="https://uploads.onecompiler.io/44e455y47/44e456xmr/bmw.png" alt="Sigla animată" class="w-24 h-24 mx-auto rounded-full glow-effect object-contain" />
       </div>
      </div>
      <h1 id="hero-title" class="font-orbitron text-5xl md:text-7xl font-black mb-4 bg-gradient-to-r from-white via-blue-200 to-white bg-clip-text text-transparent">ISTORIA BMW</h1>
      <p id="hero-subtitle" class="font-orbitron text-xl md:text-2xl text-blue-400 mb-8 tracking-widest">SHEER DRIVING PLEASURE</p>
      <p class="text-lg md:text-xl text-gray-300 mb-12 max-w-3xl mx-auto leading-relaxed">Descoperă povestea fascinantă a uneia dintre cele mai prestigioase mărci auto din lume. De la motoare de avioane la automobile de lux și performanță.</p>
      <div class="flex flex-wrap justify-center gap-4 mb-16"><button onclick="navigateTo('history')" class="px-8 py-4 bmw-blue-gradient rounded-xl font-orbitron font-bold text-lg hover:scale-105 transition-transform glow-effect"> EXPLOREAZĂ ISTORIA </button> <button onclick="navigateTo('quiz')" class="px-8 py-4 glass-effect rounded-xl font-orbitron font-bold text-lg hover:bg-white/10 transition-all border border-blue-500/50"> ÎNCEPE QUIZ-UL </button>
      </div><!-- Stats -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 max-w-4xl mx-auto">
       <div class="glass-effect rounded-2xl p-6 card-hover">
        <div class="font-orbitron text-4xl font-black text-blue-400 stat-number">
         1916
        </div>
        <div class="text-gray-400 mt-2">
         Anul Fondării
        </div>
       </div>
       <div class="glass-effect rounded-2xl p-6 card-hover">
        <div class="font-orbitron text-4xl font-black text-blue-400 stat-number">
         100+
        </div>
        <div class="text-gray-400 mt-2">
         Ani de Istorie
        </div>
       </div>
       <div class="glass-effect rounded-2xl p-6 card-hover">
        <div class="font-orbitron text-4xl font-black text-blue-400 stat-number">
         2.5M+
        </div>
        <div class="text-gray-400 mt-2">
         Vehicule/An
        </div>
       </div>
       <div class="glass-effect rounded-2xl p-6 card-hover">
        <div class="font-orbitron text-4xl font-black text-blue-400 stat-number">
         140+
        </div>
        <div class="text-gray-400 mt-2">
         Țări
        </div>
       </div>
      </div>
     </div><!-- Scroll Indicator -->
     <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 animate-bounce">
      <svg class="w-8 h-8 text-blue-400" fill="none" stroke="currentColor" viewbox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
      </svg>
     </div>
    </div><!-- Quick Links Section -->
    <div class="bg-gradient-to-b from-gray-900 to-gray-800 py-20 px-4">
     <div class="max-w-6xl mx-auto">
      <h2 class="font-orbitron text-3xl md:text-4xl font-bold text-center mb-12">DESCOPERĂ BMW</h2>
      <div class="grid md:grid-cols-3 gap-8">
       <div onclick="navigateTo('history')" class="model-card rounded-2xl p-8 card-hover cursor-pointer group">
        <div class="w-16 h-16 bmw-blue-gradient rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
         <svg class="w-8 h-8" fill="none" stroke="currentColor" viewbox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
         </svg>
        </div>
        <h3 class="font-orbitron text-xl font-bold mb-3">ISTORIE</h3>
        <p class="text-gray-400">De la motoare de avioane la automobile iconice - peste 100 de ani de inovație.</p>
       </div>
       <div onclick="navigateTo('models')" class="model-card rounded-2xl p-8 card-hover cursor-pointer group">
        <div class="w-16 h-16 bmw-blue-gradient rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
         <svg class="w-8 h-8" fill="none" stroke="currentColor" viewbox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
         </svg>
        </div>
        <h3 class="font-orbitron text-xl font-bold mb-3">MODELE</h3>
        <p class="text-gray-400">Descoperă gamele legendare - de la Seria 3 la M Power și i Series.</p>
       </div>
       <div onclick="navigateTo('quiz')" class="model-card rounded-2xl p-8 card-hover cursor-pointer group">
        <div class="w-16 h-16 bmw-blue-gradient rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
         <svg class="w-8 h-8" fill="none" stroke="currentColor" viewbox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
         </svg>
        </div>
        <h3 class="font-orbitron text-xl font-bold mb-3">QUIZ</h3>
        <p class="text-gray-400">Testează-ți cunoștințele despre BMW într-un quiz interactiv!</p>
       </div>
      </div>
     </div>
    </div>
   </section><!-- HISTORY PAGE -->
   <section id="page-history" class="page min-h-full bg-gradient-to-b from-gray-900 via-gray-800 to-gray-900 pt-24 pb-16 px-4">
    <div class="max-w-6xl mx-auto">
     <div class="text-center mb-16">
      <h1 class="font-orbitron text-4xl md:text-5xl font-black mb-4">ISTORIA BMW</h1>
      <p class="text-gray-400 text-lg max-w-2xl mx-auto">O călătorie prin timp, de la începuturile aviației până la viitorul mobilității</p>
     </div><!-- Timeline -->
     <div class="relative">
      <div class="absolute left-4 md:left-1/2 top-0 bottom-0 w-1 bg-gradient-to-b from-blue-500 via-blue-600 to-blue-700 transform md:-translate-x-1/2"></div><!-- 1916 -->
      <div class="timeline-item relative flex flex-col md:flex-row items-start mb-12 pl-12 md:pl-0">
       <div class="md:w-1/2 md:pr-12 md:text-right">
        <div class="glass-effect rounded-2xl p-6 card-hover"><span class="font-orbitron text-blue-400 text-sm font-bold">7 MARTIE 1916</span>
         <h3 class="font-orbitron text-2xl font-bold mt-2 mb-3">FONDAREA BMW</h3>
         <p class="text-gray-300">Bayerische Motoren Werke (BMW) este fondată în München, Germania. Inițial, compania producea motoare pentru avioane, contribuind la efortul de război al Germaniei în Primul Război Mondial.</p>
         <div class="mt-4 p-4 bg-blue-900/30 rounded-xl">
          <p class="text-sm text-blue-300">📍 Sediu: München, Bavaria, Germania</p>
         </div>
         <div class="mt-4 flex justify-center gap-4">
    <img src="https://uploads.onecompiler.io/44e455y47/44e456xmr/caca.jpg" alt="BMW fondare" class="rounded-lg max-w-xs shadow-lg" />
  </div>
</div>
        </div>
       </div>
       <div class="absolute left-0 md:left-1/2 w-8 h-8 bmw-blue-gradient rounded-full transform md:-translate-x-1/2 flex items-center justify-center glow-effect"><span class="text-xs font-bold">1</span>
       </div>
       <div class="hidden md:block md:w-1/2"></div>
      </div><!-- 1923 -->
      <div class="timeline-item relative flex flex-col md:flex-row items-start mb-12 pl-12 md:pl-0">
       <div class="hidden md:block md:w-1/2"></div>
       <div class="absolute left-0 md:left-1/2 w-8 h-8 bmw-blue-gradient rounded-full transform md:-translate-x-1/2 flex items-center justify-center glow-effect"><span class="text-xs font-bold">2</span>
       </div>
       <div class="md:w-1/2 md:pl-12">
        <div class="glass-effect rounded-2xl p-6 card-hover"><span class="font-orbitron text-blue-400 text-sm font-bold">1923</span>
         <h3 class="font-orbitron text-2xl font-bold mt-2 mb-3">PRIMA MOTOCICLETĂ</h3>
         <p class="text-gray-300">BMW R32 devine prima motocicletă produsă de companie. Designul său inovator cu motor boxer și transmisie pe arbore a stabilit standarde pentru industrie.</p>
         <div class="mt-4 grid grid-cols-2 gap-3">
          <div class="p-3 bg-blue-900/30 rounded-xl text-center">
           <p class="text-2xl font-bold text-blue-400">494cc</p>
           <p class="text-xs text-gray-400">Capacitate</p>
          </div>
          <div class="p-3 bg-blue-900/30 rounded-xl text-center">
           <p class="text-2xl font-bold text-blue-400">8.5 CP</p>
           <p class="text-xs text-gray-400">Putere</p>
          </div>
         </div>
         <div class="mt-4 flex justify-center">
  <img src="https://uploads.onecompiler.io/44e455y47/44e456xmr/BMW32.jpg" alt="BMW R32" class="rounded-lg max-w-xs shadow-lg" />
</div>
        </div>
       </div>
      </div><!-- 1928 -->
      <div class="timeline-item relative flex flex-col md:flex-row items-start mb-12 pl-12 md:pl-0">
       <div class="md:w-1/2 md:pr-12 md:text-right">
        <div class="glass-effect rounded-2xl p-6 card-hover"><span class="font-orbitron text-blue-400 text-sm font-bold">1928</span>
         <h3 class="font-orbitron text-2xl font-bold mt-2 mb-3">PRIMUL AUTOMOBIL</h3>
         <p class="text-gray-300">BMW achiziționează Fahrzeugfabrik Eisenach și începe producția de automobile cu BMW Dixi 3/15, bazat pe licența Austin 7 din Marea Britanie.</p>
         <div class="mt-4 p-4 bg-blue-900/30 rounded-xl">
          <p class="text-sm text-blue-300">🚗 Prima mașină BMW vândută: 748cc, 15 CP</p>
         </div>
                 <div class="mt-4 flex justify-center">
  <img src="https://uploads.onecompiler.io/44e455y47/44e456xmr/d383a59969bf9fef47ccea387aa4574e9bf34fce.webp" alt="BMW R32" class="rounded-lg max-w-xs shadow-lg" />
</div>
        </div>
       </div>
       <div class="absolute left-0 md:left-1/2 w-8 h-8 bmw-blue-gradient rounded-full transform md:-translate-x-1/2 flex items-center justify-center glow-effect"><span class="text-xs font-bold">3</span>
       </div>
       <div class="hidden md:block md:w-1/2"></div>
      </div><!-- 1936 -->
      <div class="timeline-item relative flex flex-col md:flex-row items-start mb-12 pl-12 md:pl-0">
       <div class="hidden md:block md:w-1/2"></div>
       <div class="absolute left-0 md:left-1/2 w-8 h-8 bmw-blue-gradient rounded-full transform md:-translate-x-1/2 flex items-center justify-center glow-effect"><span class="text-xs font-bold">4</span>
       </div>
       <div class="md:w-1/2 md:pl-12">
        <div class="glass-effect rounded-2xl p-6 card-hover"><span class="font-orbitron text-blue-400 text-sm font-bold">1936</span>
         <h3 class="font-orbitron text-2xl font-bold mt-2 mb-3">BMW 328 - LEGENDA</h3>
         <p class="text-gray-300">Lansarea BMW 328, considerat unul dintre cele mai importante automobile sportive din istorie. A câștigat Mille Miglia în 1940 și a stabilit standarde de design și performanță.</p>
         <div class="mt-4 grid grid-cols-3 gap-2">
          <div class="p-2 bg-blue-900/30 rounded-lg text-center">
           <p class="text-lg font-bold text-blue-400">80 CP</p>
           <p class="text-xs text-gray-400">Putere</p>
          </div>
          <div class="p-2 bg-blue-900/30 rounded-lg text-center">
           <p class="text-lg font-bold text-blue-400">150+</p>
           <p class="text-xs text-gray-400">km/h</p>
          </div>
          <div class="p-2 bg-blue-900/30 rounded-lg text-center">
           <p class="text-lg font-bold text-blue-400">464</p>
           <p class="text-xs text-gray-400">Unități</p>
          </div>
         </div>
         <div class="mt-4 flex justify-center">
  <img src="https://uploads.onecompiler.io/44e455y47/44e456xmr/328.jpg" alt="BMW R32" class="rounded-lg max-w-xs shadow-lg" />
</div>
        </div>
       </div>
      </div><!-- 1962 -->
      <div class="timeline-item relative flex flex-col md:flex-row items-start mb-12 pl-12 md:pl-0">
       <div class="md:w-1/2 md:pr-12 md:text-right">
        <div class="glass-effect rounded-2xl p-6 card-hover"><span class="font-orbitron text-blue-400 text-sm font-bold">1962</span>
         <h3 class="font-orbitron text-2xl font-bold mt-2 mb-3">NEUE KLASSE - RENAȘTEREA</h3>
         <p class="text-gray-300">BMW 1500 inaugurează seria "Neue Klasse" care salvează compania de la faliment. Acest model a definit caracterul BMW modern: sportiv, elegant și accesibil.</p>
         <div class="mt-4 p-4 bg-green-900/30 rounded-xl border border-green-500/30">
          <p class="text-sm text-green-300">✓ Acest model a salvat BMW de la faliment și a pus bazele succesului viitor</p>
         </div>
         <div class="mt-4 flex justify-center">
  <img src="https://uploads.onecompiler.io/44e455y47/44e456xmr/1500.png" alt="BMW R32" class="rounded-lg max-w-xs shadow-lg" />
</div>
        </div>
       </div>
       <div class="absolute left-0 md:left-1/2 w-8 h-8 bmw-blue-gradient rounded-full transform md:-translate-x-1/2 flex items-center justify-center glow-effect"><span class="text-xs font-bold">5</span>
       </div>
       <div class="hidden md:block md:w-1/2"></div>
      </div><!-- 1972 -->
      <div class="timeline-item relative flex flex-col md:flex-row items-start mb-12 pl-12 md:pl-0">
       <div class="hidden md:block md:w-1/2"></div>
       <div class="absolute left-0 md:left-1/2 w-8 h-8 bmw-blue-gradient rounded-full transform md:-translate-x-1/2 flex items-center justify-center glow-effect"><span class="text-xs font-bold">6</span>
       </div>
       <div class="md:w-1/2 md:pl-12">
